########################################
# Required
########################################

# Rename to terraform.tfvars and fill in. All *_password values should be strong.

root_password         = "CHANGE-ME-root"
ssh_user_password     = "CHANGE-ME-ssh"
es_admin_password     = "CHANGE-ME-elastic"
kibana_admin_password = "CHANGE-ME-kibana"
ds2_ingest_password   = "CHANGE-ME-ingest"

authorized_keys = [
  "ssh-ed25519 AAAA... you@laptop"
]

########################################
# Deploy sizing / placement
########################################

label         = "ds2-elk"
region        = "us-east"
instance_type = "g6-dedicated-4" # 8 GB, bump to g6-dedicated-8 or g7 for prod

########################################
# Admin access
########################################

# Restrict this to your corp CIDRs / VPN / jump host.
allowed_admin_cidrs = ["203.0.113.10/32"]

########################################
# DataStream 2 IP ACL
########################################
# Keep this list in sync with:
# https://techdocs.akamai.com/datastream2/changelog/jan-7-2026-ip-acl-support
# The default in variables.tf is a placeholder; replace with the live set.

# datastream2_ip_acl = [
#   "23.32.0.0/11",
#   "23.192.0.0/11",
#   "104.64.0.0/10",
#   "184.24.0.0/13",
#   "2600:1400::/32",
# ]

########################################
# Optional: Object Storage snapshot repo
########################################

# object_storage_bucket     = "ds2-snapshots"
# object_storage_region     = "us-east-1"
# object_storage_access_key = "AKI..."
# object_storage_secret_key = "..."

########################################
# Optional: Let's Encrypt
########################################

# enable_lets_encrypt = true
# public_hostname     = "ds2-elk.example.com"

########################################
# Optional: StackScript ID
########################################

# Replace with your fork once published. Default is Hideki's original.
# stackscript_id = 1059555
